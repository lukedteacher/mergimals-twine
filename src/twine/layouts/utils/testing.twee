:: dice roll

<<dice 'dice1' 'd8'>>

<<button 'reroll'>>
    <<roll '#dice1'>>
<</button>>

:: flashcard test
<div style='display: grid; grid: repeat(3, 1fr) / repeat(3, 1fr); gap: 1rem; width: min-content;'>
  <<flashcard 2 3 'equal groups' 'circle'>>
  <<flashcard 5 4 'equal groups' 'circle'>>
  <<flashcard 6 6 'equal groups' 'circle'>>
  <<flashcard 7 8 'equal groups' 'square'>>
  <<flashcard 9 3 'equal groups' 'circle'>>
  <<flashcard 12 6 'equal groups' 'circle'>>
  <<flashcard 10 9 'equal groups' 'rectangle'>>
  <<flashcard 12 2 'equal groups' 'triangle'>>
</div>

:: card test
<<card 'algelly' false 'large'>>
<<card 'algelly' false 'medium'>>
<<card 'algelly' false 'small'>>