:: cheats [nobr]
<<link 'log variables'>>
    <<script>>
        console.log(State.variables);
        console.log(State.temporary);
    <</script>>
<</link>>
<h2>items</h2>
<div style='display: grid; grid-template: repeat(6, 1fr) / repeat(5, 1fr); gap: 0.3rem;'>
  <div>
    coins
  </div>
  <div>
    <<link '=0'>>
      <<set $backpack.coin = 0>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    <<link '-1'>>
      <<set $backpack.coin -= 1>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    <<link '+1'>>
      <<set $backpack.coin += 1>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    <<link '+10'>>
      <<set $backpack.coin += 10>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    mergiballs
  </div>
  <div>
    <<link '=0'>>
      <<set $backpack.mergiball = 0>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    <<link '-1'>>
      <<set $backpack.mergiball -= 1>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    <<link '+1'>>
      <<set $backpack.mergiball += 1>>
      <<redo 'backpack'>>
    <</link>>
  </div>
  <div>
    <<link '+10'>>
      <<set $backpack.mergiball += 10>>
      <<redo 'backpack'>>
    <</link>>
  </div>
