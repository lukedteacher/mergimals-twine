<h2>injuries</h2>
<<link 'ouch'>><<set $players[$activePlayer].characters[$activeCharacter].injuries ++>><<redo 'injuries'>><</link>>
<<link 'ahhh...'>><<set $players[$activePlayer].characters[$activeCharacter].injuries -->><<redo 'injuries'>><</link>>
<h2>teleport</h2>
Enter grid coords: <<textbox '$_destination' ''>> <<button 'go'>><<run Dialog.close();>><<goto $_destination>><</button>>
<h2>keywords</h2>
CLOSED
<<link '+'>>
    <<set $players[$activePlayer].characters[$activeCharacter].keywords.closed = true>>
    <<redo 'keywords'>>
<</link>> 
<<link 'x'>>
    <<set $players[$activePlayer].characters[$activeCharacter].keywords.closed = false>>
    <<redo 'keywords'>>
<</link>><br />
FLASHLIGHT
<<link '+'>>
    <<set $players[$activePlayer].characters[$activeCharacter].keywords.flashlight = true>>
    <<redo 'keywords'>>
<</link>> 
<<link 'x'>>
    <<set $players[$activePlayer].characters[$activeCharacter].keywords.flashlight = false>>
    <<redo 'keywords'>>
<</link>><br />
DISCOUNT <<link '+'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.discount = true>><<redo 'keywords'>><</link>> <<link 'x'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.discount = false>><<redo 'keywords'>><</link>><br />
PADDLE <<link '+'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.paddle = true>><<redo 'keywords'>><</link>> <<link 'x'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.paddle = false>><<redo 'keywords'>><</link>><br />
RUSTY <<link '+'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.rusty = true>><<redo 'keywords'>><</link>> <<link 'x'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.rusty = false>><<redo 'keywords'>><</link>><br />
SHINE <<link '+'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.shine = true>><<redo 'keywords'>><</link>> <<link 'x'>><<set $players[$activePlayer].characters[$activeCharacter].keywords.shine = false>><<redo 'keywords'>><</link>><br />
<h2>mergimals</h2>
ALL
SEEN 
<<link '+'>>
    <<for _mergimal, _object range $mergimals>>
    <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[_object.name] = 'seen'>>
    <</for>>
<</link>>
<<link '-'>>
    <<for _mergimal, _object range $mergimals>>
    <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[_object.name] = 'unknown'>>
    <</for>>
<</link>> 
TAMED 
<<link '+'>>
    <<for _mergimal, _object range $mergimals>>
    <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[_object.name] = 'tamed'>>
    <</for>>
<</link>>
<<link '-'>>
    <<for _mergimal, _object range $mergimals>>
    <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[_object.name] = 'unknown'>>
    <</for>>
<</link>><br />
specific: 
<<listbox '_mergimalToChange'>>
    <<optionsfrom $mergimals>>
<</listbox>> 
<<button 'seen'>>
    <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[_mergimalToChange] = 'seen'>>
<</button>>
<<button 'tamed'>>
    <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[_mergimalToChange] = 'tamed'>>
<</button>>