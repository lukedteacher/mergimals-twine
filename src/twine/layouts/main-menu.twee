:: main menu [nobr util]
<<button 'CREATE CHARACTER' 'character creation: fast'>>
<</button>>    
@@#continue;<<button 'CONTINUE'>>
    <<if $players[$activePlayer].characters[$activeCharacter].lastPassage == 'start'>>
        <<dialog 'error'>>
            you haven't explored anything yet.<br /><br />
            <<button 'whoops'>>
                <<run Dialog.close()>>
            <</button>>
        <</dialog>>
    <<else>>
        <<script>>
            console.log(State.variables);
        <</script>>
        <<goto $players[$activePlayer].characters[$activeCharacter].lastPassage>>
    <</if>>
<</button>>@@
<<button 'NEW GAME' 'intro'>><</button>>

<<done>>
    <<script>>
        if (State.variables.players[State.variables.activePlayer].characters[State.variables.activeCharacter].lastPassage == 'start') {
            const $contButton = $('#continue').children('button').prop('disabled', true);
        }
    <</script>>
<</done>>