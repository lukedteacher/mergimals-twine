:: main menu [nobr]
Choose player: 
<<listbox '$activePlayer'>>
  <<optionsfrom Object.keys($players)>>
<</listbox>><br /><br />
Choose character: 
<<do tag 'character-selector'>>
    <<listbox '$activeCharacter'>>
        <<optionsfrom Object.keys($players[$activePlayer].characters)>>
    <</listbox>>
    <<button '+' 'character creation: fast'>><</button>><br /><br />
<</do>><<button 'CONTINUE'>>
    <<if $players[$activePlayer].characters[$activeCharacter].lastPassage == ''>>
        <<script>>
            console.log(State.variables);
        <</script>>
        <<dialog 'error'>>
            you haven't explored anything yet.<br /><br />
            <<button 'whoops'>>
                <<run Dialog.close()>>
            <</button>>
        <</dialog>>
    <<else>>
        <<script>>
            console.log(State.variables);
        <</script>>
        <<goto $players[$activePlayer].characters[$activeCharacter].lastPassage>>
    <</if>>
<</button>>
<<button 'NEW GAME' 'intro'>><</button>>

<<done>>
    <<script>>
        $('#listbox--selectedplayer').on('change', function () {
            $(document).trigger({
                type   : ':redo',
                detail : { tags : [ 'character-selector' ] }
            });
        });
    <</script>>
<</done>>