:: main menu [util]
<div style='display: flex; flex-direction: column; align-items: center;'>
  <h1>MERGIMALS</h1>
  <h2>fusion</h2>
  <img style='width: 8rem; aspect-ratio: 1 / 1;' src='images/logo/fusion.svg'>
  <div style='display: flex; gap: 2rem; margin-top: 2rem;'>
    <<button 'CREATE CHARACTER' 'create a character'>><</button>>    
    @@#continue;<<button 'CONTINUE'>>
            <<goto $players[$activePlayer].characters[$activeCharacter].lastPassage>>
    <</button>>@@
    <<button 'NEW GAME' 'intro'>><</button>>
  </div>
</div>
<<done>>
    <<script>>
        if (State.variables.players[State.variables.activePlayer].characters[State.variables.activeCharacter].lastPassage == 'start') {
            const $contButton = $('#continue').children('button').prop('disabled', true);
        }
    <</script>>
<</done>>