:: character sheet
<<set _portraitURL = $players[$activePlayer].characters[$activeCharacter].portrait>>
<div style='display: flex; align-items: center;'>
	<<print '<img class="portrait" src="' + _portraitURL + '" />'>>
	<h2 style='margin-left: 1rem;'>$activeCharacter</h2>
</div>
<<script>>
	$( function() {
		$( '#tabs' ).tabs({
			classes: {
				'ui-tabs': 'char-sheet-tabs'
			}
		});

		$( '#tabs' ).tabs('option', 'active', State.variables.sheetPage);
	} );
<</script>>
<div id='tabs' class='dialog-char-sheet-tabs'>
	<ul>
		<li><h2 style='margin: 0;'><a href='#dialog-char-sheet--character'>👤</a></h2></li>
		<li><h2 style='margin: 0;'><a href='#dialog-char-sheet--backpack'>🎒</a></h2></li>
		<li><h2 style='margin: 0;'><a href='#dialog-char-sheet--journal'>📘</a></h2></li>
    <li><h2 style='margin: 0;'><a href='#dialog-char-sheet--keywords'>🗝️</a></h2></li>
		<li><h2 style='margin: 0;'><a href='#dialog-char-sheet--world-map'>🗺️</a></h2></li>
    <li><h2 style='margin: 0;'><a href='#dialog-char-sheet--mergipedia'>📊</a></h2></li>
	</ul>
	<div id='dialog-char-sheet--character'>
		<<include 'stats'>>
		<<include 'injuries'>>
	</div>
	<div id='dialog-char-sheet--backpack'>
		<<include 'backpack items'>>
	</div>
  <div id='dialog-char-sheet--journal'>
    <<include 'journal'>>
	</div>
  <div id='dialog-char-sheet--keywords'>
    <<include 'backpack keywords'>>
	</div>
	<div id='dialog-char-sheet--world-map'>
		<<include 'world map'>>		
	</div>
	<div id='dialog-char-sheet--mergipedia'>
		<<include 'mergipedia'>>		
	</div>
</div>