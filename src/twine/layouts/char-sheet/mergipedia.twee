:: mergipedia [mergipedia util]
<<set _mergipediaStart = 0>>
<<do tag 'mergipedia'>>
  <div style='display: grid; grid: repeat(2, 1fr) / repeat(3, 1fr); gap: 1rem;'>
    <<set _mergipedia to Object.fromEntries(Object.entries($mergimals).slice(_mergipediaStart, _mergipediaStart + 6))>>
    <<for _mergimal, _object range _mergipedia>>
      <<if $players[$activePlayer].characters[$activeCharacter].mergipedia[_object.name] == 'tamed'>>
        <<card _mergimal false 'small'>>
      <<elseif $players[$activePlayer].characters[$activeCharacter].mergipedia[_object.name] == 'seen'>>
        <<card _mergimal false 'small' true>>
      <<else>>
        <<card 'unknown' false 'small'>>
      <</if>>
    <</for>>
  </div>
  <div style='display: flex; justify-content: space-between; margin: 1rem;'>
    <<button '<'>>
      <<set _mergipediaStart -= 6>>
      <<if _mergipediaStart < 0>>
        <<set _mergipediaStart = 0>>
      <</if>>
      <<redo 'mergipedia'>>
    <</button>>
    _mergipediaStart through <<-_mergipediaStart + 6>><br />
    <<button '>'>>
      <<set _mergipediaStart += 6>>
      <<if _mergipediaStart > Object.entries($mergimals).length - 6>>
        <<set _mergipediaStart = Object.entries($mergimals).length - (Object.entries($mergimals).length % 6)>>
      <</if>>
      <<redo 'mergipedia'>>
    <</button>>
  </div>
<</do>>

:: melodrake [mergimal card inspect]
<div class='flex flex-row gap-lg'>
  <div><<card 'melodrake'>></div>
  <div class='align-center-box'>
    <p><strong>name:</strong> melodrake<br />
    <strong>type:</strong> root<br />
    <strong>number:</strong> 2<br />
    <strong>strategy:</strong> produce a pair.<br />
    <strong>description:</strong> This Mergimal can play music with their body.<br />
    <strong>found:</strong> ???</p>
    <ul class='choices'>
      <li><<return 'Inspect another.'>></li>
      <li>
        <<link 'Choose this one.' 'start: part 3'>>
          <<set $players[$activePlayer].characters[$activeCharacter].starter = 'melodrake'>>
          <<set $players[$activePlayer].characters[$activeCharacter].mergipedia.melodrake = 'tamed'>>
        <</link>>
      </li>
    </ul>
  </div>
</div>

