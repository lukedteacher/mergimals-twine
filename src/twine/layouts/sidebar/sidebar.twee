:: sidebar [nobr]
<<button 'main menu'>>
    <<dialog>>
        are you sure you want to return to the menu?<br /><br />
        the last passage will be saved.<br /><br />
        <<button 'yes'>>
            <<set $players[$activePlayer].characters[$activeCharacter].lastPassage = State.passage>>
            <<run Dialog.close()>>
            <<goto 'main menu'>>
        <</button>>
        <<button 'no'>>
            <<run Dialog.close()>>
        <</button>>
    <</dialog>>
<</button>><br /><br />
<div id='sidebar-char'>
    <h2 style='margin: 0;'>$activeCharacter</h2>
    <<set _portraitURL = $players[$activePlayer].characters[$activeCharacter].portrait>>
    <<print '<img class="portrait" src="' + _portraitURL + '" />'>>
</div><br />
<<script>>
  $(function() {
    $('#sidebar-char').click( function () {
        Dialog
            .create('character information', 'dialog-char-sheet')
            .wikiPassage('character sheet')
            .open();
    });
  });
<</script>>
<<button 'swap character'>>
    <<popup 'character swap' 'character swap' 'dialog-char-swap'>>
<</button>>