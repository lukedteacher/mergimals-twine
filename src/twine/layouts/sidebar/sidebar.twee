:: sidebar [nobr]
<<button 'main menu' 'main menu'>>
<</button>><br /><br />
<<do tag 'sidebar-char'>>
  <div id='sidebar-char-box'>
    <<characterbox $activeCharacter false>>
    <div id='char-info-boxes'>
      <h2 style='margin: 0;'>👤</h2>
      <h2 style='margin: 0;'>🎒</h2>
      <h2 style='margin: 0;'>📘</h2>
      <h2 style='margin: 0;'>🗺️</h2>
    </div>
  </div>
<</do>><br />
<<script>>
  $(function() {
    $('#sidebar-char-box').click( function () {
        Dialog
            .create('character information', 'dialog-char-sheet')
            .wikiPassage('character sheet')
            .open();
    });
  });
<</script>>
<<button 'swap character' 'character swap'>><</button>>