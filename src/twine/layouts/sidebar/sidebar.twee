:: sidebar [util]
<<do tag 'sidebar-char'>>
  <div id='sidebar-char-box'>
    <<characterbox $activeCharacter false>>
    <div id='char-sheet-button-boxes'>
      <div data-page='0' class='char-sheet-button-box'>👤</div>
      <div data-page='1' class='char-sheet-button-box'>🎒</div>
      <div data-page='2' class='char-sheet-button-box'>📘</div>
    </div>
    <div id='char-sheet-button-boxes'>
      <div data-page='3' class='char-sheet-button-box'>🗝️</div>
      <div data-page='4' class='char-sheet-button-box'>🗺️</div>
      <div data-page='5' class='char-sheet-button-box'>📊</div>
    </div>
  </div>
<</do>><br />
<<script>>
  $(function() {
    $('#sidebar-char-box').click( function (event) {
      const destination = Number(event.target.dataset.page);

      if (isNaN(destination)) {
        State.variables.sheetPage = 0;
      } else {
      State.variables.sheetPage = destination;
      }

      Dialog
          .create('character information', 'dialog-char-sheet')
          .wikiPassage('character sheet')
          .open();
    });
  });
<</script>>