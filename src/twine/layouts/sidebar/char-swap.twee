:: character swap [nobr]
<<for _name, _object range $players[$activePlayer].characters>>
    <div class='char-swap-div selectable'>
        _name<br />
        <<set _portraitURL = _object.portrait>>
        <<print '<img class="portrait" src="' + _portraitURL + '" />'>>
    </div>
<</for>>
<<script>>
  $(function() {
    $('.char-swap-div').click( function () {
        console.log('make this')
    });
  });
<</script>>