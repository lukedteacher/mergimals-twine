:: StoryInit
<<script>>
  Config.passages.nobr = true;
<</script>>
<<include 'mergimals data variable'>>
<<include 'mergimals encounter table'>>
<<include 'mergimals math facts'>>

<<widget 'asil' container>>
  <<say 'Asil (Forest Witch)' 'images/characters/asil.webp'>>_contents<</say>>
<</widget>>
<<widget 'tam' container>>
  <<say 'Prof. Tamarack' 'images/characters/proftam.webp'>>_contents<</say>>
<</widget>>
<<widget 'rhia' container>>
  <<say 'Rhia (Wave University Leader)' 'images/characters/rhia.webp'>>_contents<</say>>
<</widget>>
<<widget 'matiu' container>>
  <<say 'Matiu (Forge Workshop Leader)' 'images/characters/matiu.webp'>>_contents<</say>>
<</widget>>
<<widget 'zahara' container>>
  <<say 'Zahara (Bloom Conservatory Leader)' 'images/characters/zahara.webp'>>_contents<</say>>
<</widget>>
<<widget 'bijili' container>>
  <<say 'Bijili (Deep Institute Leader)' 'images/characters/bijili.webp'>>_contents<</say>>
<</widget>>
<<widget 'axel' container>>
  <<say 'Axel (Spark Prep Leader)' 'images/characters/axel.webp'>>_contents<</say>>
<</widget>>
<<widget 'grace' container>>
  <<say 'Grace (Veil Grove Leader)' 'images/characters/grace.webp'>>_contents<</say>>
<</widget>>

<<newplayer 'luke'>>
<<set _defaultStats = {attention: 'd4', grit: 'd8', memory: 'd6', empathy: 'd10'} >>
<<newcharacter 'luke' 'Player' 'violet' 1 _defaultStats>>
<<newcharacter 'luke' 'Flow' 'cyan' 9 _defaultStats>>
<<newcharacter 'luke' 'BOB' 'orange' 3 _defaultStats>>

<<set $activePlayer = 'luke'>>
<<set $activeCharacter = 'Flow'>>

<<set $stamps = ['veil', 'wave', 'forge', 'bloom', 'spark', 'orbit']>>

<<setupfacts>>