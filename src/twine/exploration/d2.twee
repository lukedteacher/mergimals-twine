:: d2 [map]
<div class='flex-row flex items-center gap-lg'>
  <div class='explore-box'>
    <h3>EXPLORE</h3>
    <ul class='choices'>
      <li>[[Go fishing.->d2: fishing]]</li>
      <li>[[Check out the volleyball court.->d2: beach volleyball]]</li>
      <li>[[What are those surfing penguins doing?->d2: surfing contest]]</li>
    </ul>
  </div>
  <<map 'd2'>><<e>><</map>><<set $currentLocation = 'd2'>>
</div>

:: d2: fishing
<<if not $players[$activePlayer].characters[$activeCharacter].keywords.rusty == true>>
  <<include 'no rod'>>
<<else>>
  <p>(Keyword RUSTY detected)</p>
  <p>Fishing is fun!</p>
  <p>Too bad nothing is biting.</p>
  <ul class='choices'>
    <li>[[Continue exploring.->$currentLocation]]</li>
  </ul>
<</if>>