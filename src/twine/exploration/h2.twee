:: h2 [h2 raven-wing map]
<div class='flex-row flex items-center gap-lg'>
  <div class='explore-box' style='height: min-content;'>
    <h3>EXPLORE</h3>
    <ul class='choices'>
      <li>[[Look around->h2: description]]</li>
      <li>[[Nothing else yet->blah]]</li>
    </ul>
  </div>
  <<map 'h2'>><<s>><</map>><<set $players[$activePlayer].characters[$activeCharacter].worldMapPosition = 'h2'>>
</div>