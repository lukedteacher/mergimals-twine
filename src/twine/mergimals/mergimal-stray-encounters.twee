:: stray encounter [stray]
<<print "<img class='mergimal-image' src='images/mergimals/" + $mergimalEncountered.name + ".png' />">>
<p>$mergimalEncountered.strayPassageText</p>
<<set $players[$activePlayer].characters[$activeCharacter].mergipedia[$mergimalEncountered.name] = 'seen'>>
<p>Do <strong>Worksheet $mergimalEncountered.number</strong></p>
<ul class='choices'>
  <li>
    <<link 'Throw a mergiball!'>>
      <<if $players[$activePlayer].characters[$activeCharacter].backpack.mergiball < 1>>
        <<dialog>>
          <<include 'no mergiballs'>>
        <</dialog>>
      <<else>>
        <<goto 'tame attempt'>>
      <</if>>
    <</link>>
  </li>
  <li>
    <<link 'Back away slowly and continue exploring.'>>
      <<goto $players[$activePlayer].characters[$activeCharacter].worldMapPosition>>
    <</link>>
  </li>
</ul>

:: tame attempt [tame]
<<set _target = 10>>
<<set _result = 0>>
<<script>>
  const rarity = State.variables.mergimalEncountered.rarity;
  let target = 10;
  if (rarity == 'common') {
    target = 2;
  } else if (rarity == 'uncommon') {
    target = 5;
  } else {
    target = 8;
  }
  State.temporary.target = target;
<</script>>
<p>You throw the mergiball and it lands near the $mergimalEncountered.name.</p>
<p><strong>Target:</strong> _target</p>
<p><<dice 'mergiball' 'd10'>></p>
<div class='flex gap-md'>
  <<button 'reroll'>>
    <<if $players[$activePlayer].characters[$activeCharacter].backpack.mergiball < 1>>
      <<dialog>>
        <<include 'no mergiballs'>>
      <</dialog>>
    <<else>>
      <<set $players[$activePlayer].characters[$activeCharacter].backpack.mergiball -->>
      <<roll 'mergiball'>>
    <</if>>
  <</button>>
  <<button 'see what happens'>>
    <<script>>
      State.temporary.result = Number($('#mergiball').attr('data-result'));
    <</script>>
    <<if _result < _target>>
      <<dialog>>
        <<include 'tame attempt failed'>>
      <</dialog>>
    <<else>>
      <<dialog>>
        <<include 'tame attempt succeeded'>>
      <</dialog>>
    <</if>>
  <</button>>
</div>
<<done>>
  <<set $players[$activePlayer].characters[$activeCharacter].backpack.mergiball -->>
  <<roll 'mergiball'>>
<</done>>

:: tamed encounter [tamed]
<div class='flex flex-row gap-lg'>
  <div><<card $mergimalEncountered.name>></div>
  <div class='align-center-box'>
    <p><strong>name:</strong> $mergimalEncountered.name<br />
    <strong>type:</strong> $mergimalEncountered.type<br />
    <strong>number:</strong> $mergimalEncountered.number<br />
    <strong>strategy:</strong> $mergimalEncountered.strategy<br />
    <strong>description:</strong> $mergimalEncountered.tamedPassageText</p>
    <ul class='choices'>
      <li>
        <<link 'You tamed them!'>>
          <<set $players[$activePlayer].characters[$activeCharacter].mergipedia[$mergimalEncountered.name] = 'tamed'>>
          <<unset $mergimalEncountered>>
          <<goto $players[$activePlayer].characters[$activeCharacter].worldMapPosition>>
        <</link>>
      </li>
    </ul>
  </div>
</div>