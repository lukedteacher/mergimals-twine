:: create a character [util]
<h2 style='margin-bottom: 1rem;'>create a character</h2>
<div style='display: flex; flex-direction: column; gap: 1rem;'>
  <div>name: <<textbox '_newCharacterName' ''>></div>
  <div>
    pronouns: <<listbox '_newCharacterPronouns'>>
      <<option 'they'>>
      <<option 'she'>>
      <<option 'he'>>
    <</listbox>>
  </div>
  <div>color:<<set _newCharacterColor = ''>></div>
  <div style='display: grid; grid: repeat(2, 1fr) / repeat(4, 1fr); gap: 0.5rem; width: min-content;'>
    <div data-color='red' class='char-color bg-red selectable'></div>
    <div data-color='orange' class='char-color bg-orange selectable'></div>
    <div data-color='yellow' class='char-color bg-yellow selectable'></div>
    <div data-color='green' class='char-color bg-green selectable'></div>
    <div data-color='cyan' class='char-color bg-cyan selectable'></div>
    <div data-color='indigo' class='char-color bg-indigo selectable'></div>
    <div data-color='violet' class='char-color bg-violet selectable'></div>
    <div data-color='magenta' class='char-color bg-magenta selectable'></div>
  </div>
  <div>portrait:<<set _newCharacterPortraitNumber = 0>></div>
  <div style='display: grid; grid: repeat(2, 1fr) / repeat(4, 1fr); gap: 0.5rem; width: min-content;'>
    <img data-number='1' class='portrait selectable' src='images/characters/portrait_1.webp'>
    <img data-number='2' class='portrait selectable' src='images/characters/portrait_2.webp'>
    <img data-number='3' class='portrait selectable' src='images/characters/portrait_3.webp'>
    <img data-number='9' class='portrait selectable' src='images/characters/portrait_9.webp'>
    <img data-number='5' lass='portrait selectable' src='images/characters/portrait_5.webp'>
    <img data-number='6' class='portrait selectable' src='images/characters/portrait_6.webp'>
    <img data-number='7' class='portrait selectable' src='images/characters/portrait_7.webp'>
    <img data-number='8' class='portrait selectable' src='images/characters/portrait_8.webp'>
  </div>
  <<set _newCharacterStats = {attention: '', grit: '', memory: '', empathy: ''}>>
  <div>attention: <<textbox '_newCharacterStats.attention' 'd6'>></div>
  <div>grit: <<textbox '_newCharacterStats.grit' 'd6'>></div>
  <div>memory: <<textbox '_newCharacterStats.memory' 'd6'>></div>
  <div>empathy: <<textbox '_newCharacterStats.empathy' 'd6'>></div>
  <div style='width: 12rem;'>
    <<button 'submit'>>
      <<if _newCharacterName == ''>>
        <<dialog 'error'>>
          <<include 'no character name'>>
        <</dialog>>
      <<else>>
        <<newcharacter $activePlayer _newCharacterName _newCharacterColor _newCharacterPortraitNumber _newCharacterStats>>
        <<set $activeCharacter = _newCharacterName>>
        <<goto 'main menu'>>
      <</if>>
    <</button>>
  </div>
</div>
<<script>>
$(function() {
  $('.portrait').click( function () {
    $(this).toggleClass('selected').siblings().removeClass('selected');
    State.temporary.newCharacterPortraitNumber = $(this).attr('data-number');
  });
  $('.char-color').click( function () {
    $(this).toggleClass('selected').siblings().removeClass('selected');
    State.temporary.newCharacterColor = $(this).attr('data-color');
  });
});
<</script>>

:: no character name [util dialog]
<p>Please enter a character name.</p>
<<button 'Okay'>>
  <<run Dialog.close()>>
<</button>>